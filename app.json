{
  "expo": {
    "name": "cuentero",
    "slug": "cuentero",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "cuentero",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Cuentero necesita el micrófono para grabar la versión oral del cuento."
      }
    },
    "android": {
      "package": "com.javapgr.cuentero",
      "permissions": [
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": "Cuentero necesita el micrófono para grabar la versión oral del cuento."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9802124e-1b79-45cb-9b22-889789462d6d"
      }
    },
    "owner": "bit_101011"
  }
}
